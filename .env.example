# Copie este arquivo para .env.local e cole o seu "API Read Access Token" do TMDB.
TMDB_API_READ_ACCESS_TOKEN=cole_aqui_o_seu_token

# Supabase → Project Settings → API Keys: copie a "Project URL" e a "Publishable key" (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=cole_aqui_a_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=cole_aqui_a_publishable_key
